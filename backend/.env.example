# Base64 HS256 key, tự sinh: openssl rand -base64 64
JWT_ACCESS_TOKEN_SECRET=replace-with-your-own-base64-secret
JWT_ACCESS_TOKEN_EXPIRATION=3600000

JWT_REFRESH_TOKEN_SECRET=replace-with-your-own-base64-secret
JWT_REFRESH_TOKEN_EXPIRATION=604800000

# Tài khoản admin được seed tự động khi app khởi động lần đầu (đổi giá trị thật trong .env, không commit)
ADMIN_EMAIL=admin@foodie.local
ADMIN_PASSWORD=ChangeMe123
ADMIN_FULL_NAME=System Admin
ADMIN_PHONE_NUMBER=0900000000

SERVER_PORT=8080
API_PREFIX=/api/v1

SPRING_SECURITY_USER_NAME=root
SPRING_SECURITY_USER_PASSWORD=changeme

SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/foodie
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=changeme

FRONTEND_URL=http://food-website:3000

MYSQL_DATABASE=foodie
MYSQL_ROOT_PASSWORD=changeme

CLOUDINARY_CLOUD_NAME=replace-with-your-cloud-name
CLOUDINARY_API_KEY=replace-with-your-api-key
CLOUDINARY_API_SECRET=replace-with-your-api-secret
